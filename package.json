{
  "name": "stormwatch",
  "version": "1.0.0-beta.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "guidelines:check": "code-guidelines check"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "hls.js": "^1.7.3",
    "leaflet": "^1.9.4",
    "mpegts.js": "^1.8.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@devenvy/code-guidelines": "file:D:/Source/.code-guidelines-local/devenvy-code-guidelines-1.0.0.tgz",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "description": "Client-side severe weather monitor: NWS alerts, radar with forecast, conditions, tropical storms and your own live TV.",
  "license": "MIT",
  "prettier": "@devenvy/code-guidelines/prettier/angular",
  "codeGuidelines": {
    "env": "browser",
    "typescript": true,
    "angular": true,
    "vitest": true
  }
}
