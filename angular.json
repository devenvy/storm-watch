{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "stormwatch": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "sw",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["node_modules/leaflet/dist/leaflet.css", "src/styles.scss"],
            "allowedCommonJsDependencies": ["mpegts.js", "leaflet"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "index": {
                "input": "src/index.prod.html",
                "output": "index.html"
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "stormwatch:build:production"
            },
            "development": {
              "buildTarget": "stormwatch:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4317,
            "host": "127.0.0.1"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": ["text-summary", "json-summary", "json", "html"],
            "coverageThresholds": {
              "statements": 85,
              "branches": 85,
              "functions": 85,
              "lines": 85
            }
          }
        }
      }
    }
  }
}
